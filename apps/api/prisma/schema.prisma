generator client {
  provider = "prisma-client-js"
}

// Default: SQLite for zero-deps Phase 1 demo.
// For Postgres: set provider = "postgresql" and DATABASE_URL accordingly.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  phoneE164       String    @unique
  phoneVerifiedAt DateTime?
  email           String?
  displayName     String?
  locale          String    @default("en-IN")
  role            String    @default("user")
  status          String    @default("active")
  /// free | plus | family | fleet — entitlements stub (P4)
  subscriptionTier String  @default("free")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  preferences     Preference?
  vehicles        Vehicle[]
  refreshTokens   RefreshToken[]
  sessions        ChargingSession[]
  costRecords     CostRecord[]
  routePlans      RoutePlan[]
  otpRequests     OtpRequest[]
  failureReports  FailureReport[]
  notifications   Notification[]
  pushTokens      PushToken[]
  stationReviews  StationReview[]
  consents        ConsentRecord[]
  aiAudits        AiToolAudit[]
  reputation      UserReputation?
  communityPosts  CommunityPost[]
  communityVotes  CommunityVote[]
  subscriptions   UserSubscription[]
  fleetMemberships FleetMembership[]
  moderatedPosts  CommunityPost[] @relation("PostModerator")
}

model OtpRequest {
  id        String   @id @default(uuid())
  phoneE164 String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deviceId  String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Preference {
  userId                   String  @id
  user                     User    @relation(fields: [userId], references: [id])
  unitsJson                String  @default("{\"distance\":\"km\",\"energy\":\"kwh\",\"currency\":\"INR\"}")
  notifyPush               Boolean @default(true)
  notifySession            Boolean @default(true)
  preferredConnectorsJson  String  @default("[\"CCS2\",\"Type2\"]")
  tripStrategyDefault      String  @default("fastest")
  iceVehicleLabel          String?
  iceMileageKmPerL         Float?
  iceFuelPricePaisePerL    Int?
  theme                    String  @default("dark")
  updatedAt                DateTime @updatedAt
}

model VehicleSpec {
  id                            String   @id @default(uuid())
  make                          String
  model                         String
  variant                       String
  modelYear                     Int?
  batteryKwhStated              Float
  batteryKwhGross               Float?
  batteryKwhUsable              Float?
  usableEqualsStated            Boolean  @default(false)
  batteryChemistry              String?
  efficiencyWhPerKmCity         Float
  efficiencyWhPerKmHighway      Float
  maxAcKw                       Float
  maxDcKw                       Float
  connectorAc                   String
  connectorDc                   String
  connectorTypesJson            String
  recommendedChargeLimitPercent Int      @default(80)
  rangeMidcKm                   Int?
  rangeAraiKm                   Int?
  source                        String   @default("manual_admin")
  sourceMetadataJson            String   @default("{}")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  vehicles                      Vehicle[]

  @@unique([make, model, variant, modelYear])
}

model Vehicle {
  id                       String    @id @default(uuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id])
  nickname                 String?
  registrationNo           String?
  make                     String
  model                    String
  variant                  String?
  modelYear                Int?
  vehicleSpecId            String
  vehicleSpec              VehicleSpec @relation(fields: [vehicleSpecId], references: [id])
  isPrimary                Boolean   @default(true)
  telemetrySourcePreferred String    @default("manual")
  oemLinkStatus            String    @default("none")
  oemAdapterId             String?
  operatorAdapterId        String?
  specOverridesJson        String    @default("{}")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  telemetry         Telemetry[]
  chargingSessions  ChargingSession[]
  costRecords       CostRecord[]
  routePlans        RoutePlan[]
  consents          ConsentRecord[]
}

model Telemetry {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  observedAt   DateTime
  recordedAt   DateTime @default(now())
  source       String   @default("manual")
  socPercent   Float
  rangeKmEst   Float?
  odometerKm   Float?
  lat          Float?
  lng          Float?
  confidence   Int      @default(90)
  createdBy    String?
}

model Operator {
  id                 String    @id @default(uuid())
  code               String    @unique
  name               String
  website            String?
  capabilitiesJson   String    @default("[\"catalog\"]")
  status             String    @default("active")
  /// demo | prospect | contracted | live — never claim live without contract
  partnershipStatus  String    @default("demo")
  partnershipNotes   String?
  featuredCorridorJson String @default("[]")
  adapterId          String?
  contactEmail       String?
  updatedAt          DateTime  @updatedAt @default(now())
  stations           Station[]
  partnershipPrograms PartnershipProgram[]
}

model Station {
  id                     String    @id @default(uuid())
  operatorId             String?
  operator               Operator? @relation(fields: [operatorId], references: [id])
  externalId             String?
  name                   String
  addressLine            String?
  city                   String?
  state                  String?
  pincode                String?
  lat                    Float
  lng                    Float
  amenitiesJson          String    @default("[]")
  accessType             String    @default("public")
  isOpen24x7             Boolean   @default(false)
  openingHoursJson       String?
  status                 String    @default("active")
  source                 String    @default("admin")
  isDemo                 Boolean   @default(true)
  sourceMetadataJson     String    @default("{}")
  reliabilityScore       Int?
  reliabilityConfidence  Int?
  reliabilityUpdatedAt   DateTime?
  lastVerifiedAt         DateTime?
  quarantineUntil        DateTime?
  quarantineReason       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  connectors           Connector[]
  tariffs              Tariff[]
  chargingSessions     ChargingSession[]
  failureReports       FailureReport[]
  reliabilitySnapshot  StationReliability?
  reviews              StationReview[]
  observations         AvailabilityObservation[]
}

model Connector {
  id            String  @id @default(uuid())
  stationId     String
  station       Station @relation(fields: [stationId], references: [id])
  connectorType String
  powerKw       Float
  currentType   String
  statusNominal String  @default("unknown")
}

model Tariff {
  id                String  @id @default(uuid())
  stationId         String
  station           Station @relation(fields: [stationId], references: [id])
  connectorType     String?
  pricingModel      String  @default("per_kwh")
  energyRatePaise   Int
  sessionFeePaise   Int     @default(0)
  currency          String  @default("INR")
  source            String  @default("admin")
}

model ChargingSession {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  vehicleId          String
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id])
  stationId          String?
  station            Station?  @relation(fields: [stationId], references: [id])
  startedAt          DateTime
  endedAt            DateTime?
  status             String    @default("completed")
  energyKwh          Float?
  maxPowerKw         Float?
  avgPowerKw         Float?
  socStart           Float?
  socEnd             Float?
  costPaiseEstimated Int?
  costPaiseActual    Int?
  source             String    @default("manual")
  note               String?
  seriesJson         String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  costRecords CostRecord[]
}

model CostRecord {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  vehicleId          String?
  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id])
  chargingSessionId  String?
  chargingSession    ChargingSession? @relation(fields: [chargingSessionId], references: [id])
  category           String
  amountPaise        Int
  energyKwh          Float?
  recordedAt         DateTime
  note               String?
  source             String           @default("manual")
  createdAt          DateTime         @default(now())
}

model RoutePlan {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  vehicleId             String
  vehicle               Vehicle  @relation(fields: [vehicleId], references: [id])
  originLat             Float
  originLng             Float
  originLabel           String?
  destinationLat        Float
  destinationLng        Float
  destinationLabel      String?
  socStartPercent       Float
  targetSocArrival      Float
  distanceKm            Float
  energyKwhEst          Float
  destSocPercent        Float
  confidence            Int
  safetyReservePercent  Float
  provider              String   @default("heuristic")
  strategy              String   @default("fastest")
  status                String   @default("draft")
  stopsJson             String   @default("[]")
  alternativesJson      String   @default("[]")
  disclaimer            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ── Phase 2: reliability, reports, notifications ──

model FailureReport {
  id               String   @id @default(uuid())
  stationId        String
  station          Station  @relation(fields: [stationId], references: [id])
  connectorId      String?
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  reportedAt       DateTime @default(now())
  category         String
  severity         String   @default("medium")
  description      String?
  mediaUrlsJson    String   @default("[]")
  status           String   @default("open")
  moderationNotes  String?
  sourceMetadataJson String @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([stationId, reportedAt])
  @@index([userId, reportedAt])
  @@index([status])
}

model StationReliability {
  stationId        String   @id
  station          Station  @relation(fields: [stationId], references: [id])
  score            Int?
  confidence       Int
  componentsJson   String   @default("{}")
  sampleSizesJson  String   @default("{}")
  weightsJson      String   @default("{}")
  display          String   @default("insufficient_data")
  computedAt       DateTime @default(now())
}

model StationReview {
  id        String   @id @default(uuid())
  stationId String
  station   Station  @relation(fields: [stationId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stationId, userId])
}

model AvailabilityObservation {
  id             String   @id @default(uuid())
  stationId      String
  station        Station  @relation(fields: [stationId], references: [id])
  observedAt     DateTime @default(now())
  status         String
  source         String   @default("crowd")
  reporterUserId String?
  confidence     Int      @default(50)
  createdAt      DateTime @default(now())

  @@index([stationId, observedAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  channel   String    @default("inapp")
  type      String
  title     String
  body      String
  payloadJson String  @default("{}")
  status    String    @default("queued")
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
}

model ReliabilityJob {
  id          String   @id @default(uuid())
  status      String   @default("completed")
  stationsTouched Int  @default(0)
  note        String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

// ── Phase 3: integrations, consent, AI audit, circuit breakers ──

model ConsentRecord {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id])
  adapterId     String
  purpose       String
  policyVersion String
  granted       Boolean
  grantedAt     DateTime?
  revokedAt     DateTime?
  metadataJson  String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, adapterId])
  @@index([vehicleId])
}

model AdapterHealth {
  adapterId      String   @id
  kind           String
  displayName    String
  mode           String   @default("demo")
  status         String   @default("healthy")
  circuitState   String   @default("closed")
  failureCount   Int      @default(0)
  successCount   Int      @default(0)
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  lastError      String?
  openedAt       DateTime?
  metadataJson   String   @default("{}")
  updatedAt      DateTime @updatedAt
}

model AiToolAudit {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tool       String
  allowed    Boolean
  reason     String
  argsJson   String   @default("{}")
  resultJson String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([tool, allowed])
}

// ── Phase 4: community, reputation, subscriptions, fleet, partnerships ──

model UserReputation {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id])
  score                Int      @default(0)
  tier                 String   @default("newcomer")
  verifiedReportCount  Int      @default(0)
  helpfulPostCount     Int      @default(0)
  usefulVotesReceived  Int      @default(0)
  rejectedCount        Int      @default(0)
  spamFlags            Int      @default(0)
  componentsJson       String   @default("{}")
  updatedAt            DateTime @updatedAt
}

model CommunitySpace {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  description     String?
  /// general | vehicle_model | highway | tips
  kind            String   @default("general")
  make            String?
  model           String?
  variant         String?
  isVerifiedOwnersOnly Boolean @default(true)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  posts           CommunityPost[]
}

model CommunityPost {
  id              String   @id @default(uuid())
  spaceId         String
  space           CommunitySpace @relation(fields: [spaceId], references: [id])
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  /// station_experience | trip_share | range_share | cost_share | tip | photo | discussion
  postType        String
  title           String
  body            String
  stationId       String?
  vehicleMake     String?
  vehicleModel    String?
  vehicleVariant  String?
  /// Optional structured payload (range km, cost paise, trip distance, etc.)
  metricsJson     String   @default("{}")
  photoUrlsJson   String   @default("[]")
  usefulCount     Int      @default(0)
  /// pending | published | rejected | hidden
  moderationStatus String  @default("published")
  moderationNotes String?
  moderatedById   String?
  moderatedBy     User?    @relation("PostModerator", fields: [moderatedById], references: [id])
  moderatedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  votes CommunityVote[]

  @@index([spaceId, createdAt])
  @@index([authorId, createdAt])
  @@index([moderationStatus])
  @@index([postType])
}

model CommunityVote {
  id        String   @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// useful | report_spam
  kind      String   @default("useful")
  createdAt DateTime @default(now())

  @@unique([postId, userId, kind])
  @@index([userId])
}

model UserSubscription {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  tier              String
  status            String   @default("active")
  paymentProvider   String   @default("stub")
  externalRef       String?
  startedAt         DateTime @default(now())
  endsAt            DateTime?
  metadataJson      String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, status])
}

model FleetOrg {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  status       String   @default("stub_active")
  note         String   @default("Fleet MVP stub — not a live telematics fleet product")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      FleetMembership[]
  vehicles     FleetVehicle[]
}

model FleetMembership {
  id        String   @id @default(uuid())
  orgId     String
  org       FleetOrg @relation(fields: [orgId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// owner | admin | driver | viewer
  role      String   @default("viewer")
  createdAt DateTime @default(now())

  @@unique([orgId, userId])
}

model FleetVehicle {
  id        String   @id @default(uuid())
  orgId     String
  org       FleetOrg @relation(fields: [orgId], references: [id])
  label     String
  make      String
  model     String
  variant   String?
  /// Linked personal vehicle id when consented — optional
  vehicleId String?
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@index([orgId])
}

model PartnershipProgram {
  id              String   @id @default(uuid())
  operatorId      String?
  operator        Operator? @relation(fields: [operatorId], references: [id])
  code            String   @unique
  title           String
  /// featured_corridor | reliability_partner | directory_only | prospect
  kind            String   @default("prospect")
  status          String   @default("draft")
  corridorJson    String   @default("[]")
  liveClaim       Boolean  @default(false)
  note            String   @default("No live partnership claimed until contracted")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
